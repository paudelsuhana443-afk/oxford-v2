#. Plugin Name of the plugin
#: dynamic-tags-for-elementor.php
msgid "Dynamic Tags for Elementor"
msgstr "Elementor এর জন্য ডাইনামিক ট্যাগস"

#. Description of the plugin
#: dynamic-tags-for-elementor.php
msgid ""
"Enables dynamic tag functionality for the free version of Elementor and "
"allows creating custom tags."
msgstr ""
"Elementor-এর ফ্রি সংস্করণের জন্য ডাইনামিক ট্যাগ সুবিধা চালু করে এবং কাস্টম ট্যাগ "
"তৈরি করতে দেয়।"

#. Author of the plugin
#: dynamic-tags-for-elementor.php
msgid "Md Mustafa Kamal Hossain"
msgstr "মো. মুস্তাফা কামাল হোসাইন"

#: dynamic-tags-for-elementor.php:139
msgid ""
"Dynamic Tags for Elementor requires Elementor to be installed and active."
